# Public site URL (canonical URLs, sitemap, Open Graph). No trailing slash.
# On Netlify you can leave this empty until you add a custom domain — Netlify's URL is used.
NEXT_PUBLIC_SITE_URL=

# Contact numbers used before Supabase is connected (afterwards, set them in /admin → Business Info).
# WhatsApp: country code + number, digits only, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE=

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser. Used only to store/read the Instagram token.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Instagram long-lived token (alternative to saving it in /admin/instagram)
INSTAGRAM_ACCESS_TOKEN=

# Random string; the Netlify scheduled function sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
